{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bantvision.local/contracts/analysis-job.schema.json",
  "title": "BantVision video analiz işi (web'den yüklenen video)",
  "type": "object",
  "required": ["schema", "id", "status", "createdAt", "updatedAt", "expiresAt", "video", "options", "progress"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "bantvision.analysis-job.v1" },
    "id": { "type": "string", "format": "uuid" },
    "status": { "enum": ["queued", "running", "done", "failed", "expired"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time", "description": "Bu andan sonra video ve sonuç dosyaları silinir; özet kalır" },
    "video": {
      "type": "object", "required": ["name", "sizeBytes"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "seconds": { "type": "number", "minimum": 0 },
        "fps": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "options": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "preset": { "enum": ["generic", "egg", "flour", "box", "people", "vehicle", "animal", "safety"], "description": "people / vehicle / animal: iki yönlü giriş/çıkış sayımı (countMode detect); safety: poz güvenlik alarmı (sayım yok; countMode, truth, direction, line, countLine, roi, roiPolygon, bgRange, productLength, countAnchor verilmez)" },
        "countMode": { "enum": ["blob", "linescan", "detect"], "description": "Sayım yöntemi; verilmezse hazır profilden (un, koli: linescan; kişi: detect)" },
        "countAnchor": { "enum": ["center", "bottom"], "description": "detect: kamera tepeden (center) ya da yandan/eğik (bottom, çizgi zeminde)" },
        "productLength": { "type": "number", "exclusiveMinimum": 0, "maximum": 2, "description": "linescan: tek ürün boyu (ROI akış uzunluğuna oranla); verilmezse öğrenilir" },
        "truth": { "type": "integer", "minimum": 1, "description": "Elle sayılan doğru adet; hata yüzdesi hesaplanır" },
        "direction": { "enum": ["down", "up", "right", "left"] },
        "roi": {
          "type": "object", "required": ["x", "y", "width", "height"], "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        "roiPolygon": { "$ref": "product-profile.schema.json#/properties/roiPolygon" },
        "countLine": { "$ref": "product-profile.schema.json#/properties/countLine" },
        "line": { "type": "number", "minimum": 0, "maximum": 1 },
        "bgRange": {
          "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 },
          "description": "Boş bandın göründüğü aralık (sn)"
        },
        "safety": {
          "type": "object", "additionalProperties": false,
          "description": "Yalnızca preset safety: kurallar; verilmeyen kural varsayılanla çalışır (eller yukarı açık 3 sn, yerde yatma açık 10 sn). En az biri açık olmalı",
          "properties": {
            "handsUp": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "seconds": { "type": "number", "minimum": 3, "maximum": 5 }
              }
            },
            "lying": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "seconds": { "type": "number", "minimum": 5, "maximum": 30 }
              }
            }
          }
        }
      }
    },
    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "stage": { "enum": ["calibrating", "counting", "encoding"] },
    "result": {
      "type": "object", "required": ["count", "files"], "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0, "description": "Sayılan adet; iki yönlü sayımda giriş; safety işinde alarm sayısı" },
        "countOut": { "type": "integer", "minimum": 0, "description": "İki yönlü sayımda (detect) çıkış" },
        "truth": { "type": ["integer", "null"] },
        "errorPct": { "type": ["number", "null"] },
        "calibration": { "type": "object" },
        "processingFps": { "type": ["number", "null"] },
        "device": {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "description": "Modelin çalıştığı cihaz (yalnız model kullanan analizlerde)",
          "properties": {
            "kind": { "enum": ["cpu", "gpu"] },
            "name": { "type": "string" },
            "note": { "type": ["string", "null"], "description": "Ekran kartından işlemciye düşüldüyse nedeni (Türkçe)" }
          }
        },
        "alarms": {
          "type": "array", "maxItems": 500,
          "description": "Yalnızca safety işlerinde: alarm listesi (en çok 500; count gerçek toplamdır). Resim yalnızca ilk 50 alarmda vardır",
          "items": {
            "type": "object", "required": ["kind", "trackId", "startS", "atS", "endS", "image"], "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["handsUp", "lying"] },
              "trackId": { "type": "integer" },
              "startS": { "type": "number", "minimum": 0, "description": "Pozun başladığı video saniyesi" },
              "atS": { "type": "number", "minimum": 0, "description": "Alarmın çaldığı video saniyesi" },
              "endS": { "type": ["number", "null"], "minimum": 0, "description": "Pozun bittiği saniye; video bitince hâlâ sürüyorsa video sonu" },
              "image": { "type": ["string", "null"], "pattern": "^alarm-[0-9]{1,2}\\.jpg$", "description": "Alarm anının işaretli karesi (files içinde); resimsiz alarmda null" }
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "anyOf": [
              { "enum": ["annotated.mp4", "counts.csv", "alarms.csv", "profile.json", "background.png"] },
              { "type": "string", "pattern": "^alarm-[0-9]{1,2}\\.jpg$" }
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "error": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "done" } } }, "then": { "required": ["result"] } },
    { "if": { "properties": { "status": { "const": "failed" } } }, "then": { "required": ["error"] } },
    {
      "if": { "required": ["options"], "properties": { "options": { "required": ["preset"], "properties": { "preset": { "const": "safety" } } } } },
      "else": { "properties": { "result": { "not": { "required": ["alarms"] } } } }
    }
  ]
}
