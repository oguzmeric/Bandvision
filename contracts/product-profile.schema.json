{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bantvision.profile.v1",
  "title": "BantVision ürün profili",
  "type": "object",
  "required": ["schema", "id", "name", "roi", "linePosition", "direction", "diffThreshold",
               "expectedArea", "minAreaFactor", "minAreaAbs", "splitTouching", "maxMultiplicity",
               "closeIterations", "processingWidth", "minHits", "maxMatchDistance", "backgroundRate"],
  "properties": {
    "schema": { "const": "bantvision.profile.v1" },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "roi": {
      "type": "object", "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "roiPolygon": {
      "description": "İsteğe bağlı çokgen ROI (algoritma §2.0). Varsa maske = roi dikdörtgeni ∩ çokgen; roi çokgenin sınır kutusudur.",
      "type": "array", "minItems": 3, "maxItems": 12,
      "items": { "$ref": "#/$defs/point" }
    },
    "countLine": {
      "description": "İsteğe bağlı açılı sayım çizgisi (algoritma §4.8). Akış, a'dan b'ye yürürken sağ el tarafıdır. Varsa direction/linePosition sayımda kullanılmaz.",
      "type": "object", "required": ["a", "b"], "additionalProperties": false,
      "properties": {
        "a": { "$ref": "#/$defs/point" },
        "b": { "$ref": "#/$defs/point" }
      }
    },
    "countMode": {
      "description": "Sayım yöntemi. blob: arka plan farkı + izleme (ayrık ürünler, varsayılan). linescan: şerit tarama (§4.9; tek sıra gelen bitişik/aralıklı hacimli ürünler: torba, koli; boş bant öğrenmesi gerekmez, açılı çizgiyle kullanılmaz). detect: nesne tanıma + iki yönlü geçiş (§4.10; kişi, araç, hayvan): direction yönünde geçen giriş, tersi çıkış sayılır. safety: poz güvenlik alarmı (eller yukarı, yerde yatan kişi).",
      "enum": ["blob", "linescan", "detect", "safety"]
    },
    "detectClasses": {
      "description": "detect: sayılacak sınıflar (COCO adları). Kişi: person; araç: car, truck, bus, motorcycle, bicycle; hayvan: cow, sheep, horse, dog, cat, bird.",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["person", "bicycle", "car", "motorcycle", "bus", "truck", "bird", "cat", "dog", "horse", "sheep", "cow"] }
    },
    "detectConfidence": {
      "description": "detect: yeni iz başlatan en düşük tanıma güveni (daha düşükler yalnızca mevcut izi sürdürür).",
      "type": "number", "minimum": 0.05, "maximum": 0.95
    },
    "countAnchor": {
      "description": "detect: çizgiye göre konum noktası. center: kutu merkezi (tepeden kamera); bottom: alt orta (yatık kamera, ayak — zemindeki çizgiyle tutarlı).",
      "enum": ["center", "bottom"]
    },
    "safety": {
      "description": "safety: poz güvenlik alarmı ayarları (tasarım docs/superpowers/specs/2026-10-06-poz-guvenlik-design.md). Yoksa varsayılanlar: ikisi açık, 3 ve 10 sn, resim kapalı.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "handsUp": { "type": "object", "additionalProperties": false, "required": ["enabled", "seconds"],
          "properties": { "enabled": { "type": "boolean" }, "seconds": { "type": "number", "minimum": 3, "maximum": 5 } } },
        "lying": { "type": "object", "additionalProperties": false, "required": ["enabled", "seconds"],
          "properties": { "enabled": { "type": "boolean" }, "seconds": { "type": "number", "minimum": 5, "maximum": 30 } } },
        "sendImage": { "type": "boolean" }
      }
    },
    "staffColors": {
      "description": "detect (kişi): personel üniforma renkleri, CIE Lab (D65). Bu renkteki kişilerin geçişleri giriş/çıkışa eklenmez, personel geçişi sayılır (algoritma §4.10 eki). Yoksa ya da boşsa kapalı.",
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["L", "a", "b"],
        "properties": {
          "L": { "type": "number", "minimum": 0, "maximum": 100 },
          "a": { "type": "number", "minimum": -128, "maximum": 127 },
          "b": { "type": "number", "minimum": -128, "maximum": 127 }
        }
      }
    },
    "productLength": {
      "description": "linescan: tek ürünün akış boyunca boyu, ROI'nin akış eksenindeki uzunluğuna oranla. 0 = otomatik öğren.",
      "type": "number", "minimum": 0, "maximum": 2
    },
    "linePosition": { "type": "number", "minimum": 0, "maximum": 1 },
    "direction": { "enum": ["down", "up", "right", "left"] },
    "diffThreshold": { "type": "integer", "minimum": 5, "maximum": 120 },
    "expectedArea": { "type": "number", "minimum": 0 },
    "minAreaFactor": { "type": "number", "minimum": 0.05, "maximum": 1 },
    "minAreaAbs": { "type": "number", "minimum": 0 },
    "splitTouching": { "type": "boolean" },
    "maxMultiplicity": { "type": "integer", "minimum": 1, "maximum": 20 },
    "closeIterations": { "type": "integer", "minimum": 0, "maximum": 4 },
    "processingWidth": { "type": "integer", "minimum": 64, "maximum": 640 },
    "minHits": { "type": "integer", "minimum": 1, "maximum": 10 },
    "maxMatchDistance": { "type": "number", "minimum": 0.01, "maximum": 0.5 },
    "backgroundRate": { "type": "number", "minimum": 0.0005, "maximum": 0.2 },
    "source": {
      "type": "object",
      "properties": {
        "rotation": { "enum": [0, 90, 180, 270] },
        "referenceFps": { "type": "number", "minimum": 5, "maximum": 240, "default": 60 }
      }
    },
    "scale": {
      "type": "object",
      "properties": { "mmPerPixel": { "type": ["number", "null"], "exclusiveMinimum": 0 } }
    },
    "qc": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "geometry": {
          "type": "object",
          "properties": {
            "areaMinFactor": { "type": "number" }, "areaMaxFactor": { "type": "number" },
            "aspectMin": { "type": "number" }, "aspectMax": { "type": "number" },
            "solidityMin": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "spots": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "darkDelta": { "type": "integer", "minimum": 5, "maximum": 200 },
            "maxSpotAreaRatio": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "barcode": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "symbologies": { "type": "array", "items": { "enum": ["ean13", "ean8", "code128", "code39", "qr", "datamatrix"] } },
            "pattern": { "type": ["string", "null"] }
          }
        },
        "text": {
          "type": "object",
          "properties": { "required": { "type": "boolean" }, "pattern": { "type": ["string", "null"] } }
        },
        "sizeClasses": {
          "type": "array",
          "items": { "type": "object", "required": ["name", "maxMm"],
                     "properties": { "name": { "type": "string" }, "maxMm": { "type": "number" } } }
        },
        "saveNokImages": { "type": "boolean" }
      }
    },
    "io": {
      "type": "object",
      "properties": {
        "bridgeHost": { "type": ["string", "null"] },
        "countPulse": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "channel": { "type": "integer", "minimum": 1, "maximum": 4 },
                          "widthMs": { "type": "integer", "minimum": 5, "maximum": 2000 } }
        },
        "eject": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "channel": { "type": "integer", "minimum": 1, "maximum": 4 },
                          "distanceMm": { "type": "number", "minimum": 0 },
                          "widthMs": { "type": "integer", "minimum": 5, "maximum": 2000 },
                          "latencyCompensationMs": { "type": "integer" } }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object", "required": ["x", "y"], "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
